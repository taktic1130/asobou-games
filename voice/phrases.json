[
 {
  "id": "4339e6c3",
  "text": "どろんこに なっちゃった。 スポンジで ごしごし してね"
 },
 {
  "id": "c4cc8e47",
  "text": "あわあわ〜"
 },
 {
  "id": "b6a27916",
  "text": "あわあわ！ つぎは シャワーで ながそう"
 },
 {
  "id": "763d0ac3",
  "text": "きもちいい〜"
 },
 {
  "id": "8e2e2007",
  "text": "きれいに なった！ さいごに ふきふき して ぴかぴかに しよう"
 },
 {
  "id": "9afd8335",
  "text": "ぴかぴか！ ありがとう！"
 },
 {
  "id": "2d5b4b5f",
  "text": "シールを はって あげよう"
 },
 {
  "id": "57ae1229",
  "text": "いってきまーす！"
 },
 {
  "id": "3d7e422c",
  "text": "ゆびで クリームを ぬろう！"
 },
 {
  "id": "cfa1a547",
  "text": "いちごや おほしさまで かざろう！"
 },
 {
  "id": "5a7c79e5",
  "text": "ろうそくを たてよう！ タッチしてね"
 },
 {
  "id": "77c2e8c6",
  "text": "ぜんぶ ぬれた！"
 },
 {
  "id": "aeb4d4c1",
  "text": "のせたよ！ タッチで うごかせるよ"
 },
 {
  "id": "c7b471ef",
  "text": "ゆびで かいてね"
 },
 {
  "id": "4ef1c702",
  "text": "ケーキを きって みんなで たべよう！ ケーキを タッチしてね"
 },
 {
  "id": "f4280c51",
  "text": "いただきます！"
 },
 {
  "id": "8a142845",
  "text": "わーい！"
 },
 {
  "id": "731ac0fc",
  "text": "ありがとう！"
 },
 {
  "id": "ad4b4204",
  "text": "ぜんぶ たべちゃった！ ごちそうさま！ おいしかったね"
 },
 {
  "id": "a2fe1bee",
  "text": "でんきを けすよ"
 },
 {
  "id": "db6f8215",
  "text": "ふーって して！ ろうそくを タッチしてね"
 },
 {
  "id": "34cb5f7e",
  "text": "それは いらないよ"
 },
 {
  "id": "e09c7644",
  "text": "いらないよ〜"
 },
 {
  "id": "c8f744ca",
  "text": "トントン きってね"
 },
 {
  "id": "9c671c8b",
  "text": "ひを つけて、 まぜまぜ しよう！"
 },
 {
  "id": "b48abfa6",
  "text": "じゅーじゅー やいてるよ"
 },
 {
  "id": "bf2dfe87",
  "text": "じゅーじゅー…"
 },
 {
  "id": "3743b039",
  "text": "まぜまぜ しよう！"
 },
 {
  "id": "015b8be8",
  "text": "オーブンに いれよう！"
 },
 {
  "id": "7f5c0976",
  "text": "いち"
 },
 {
  "id": "ee2568ea",
  "text": "に"
 },
 {
  "id": "cd4d6219",
  "text": "さん"
 },
 {
  "id": "582fae24",
  "text": "やけたよ！ あけてね"
 },
 {
  "id": "51cb7808",
  "text": "できあがり！ トッピング しよう！"
 },
 {
  "id": "7d28a879",
  "text": "もぐもぐ…"
 },
 {
  "id": "c74c9b79",
  "text": "すっごく おいしい！ ありがとう！"
 },
 {
  "id": "0afba090",
  "text": "おいしい！ ありがとう！"
 },
 {
  "id": "4b3a5602",
  "text": "ぷくぷく してきた！ ひっくりかえして！"
 },
 {
  "id": "4cddb6a5",
  "text": "あっ！ はんたいからも くるよ！"
 },
 {
  "id": "016ea09b",
  "text": "よる に なったよ"
 },
 {
  "id": "7c677367",
  "text": "あさ に なったよ"
 },
 {
  "id": "7615f06a",
  "text": "ぐるっと まわる せんろ が できた！"
 },
 {
  "id": "53c8cd99",
  "text": "せんろ が できた！ しゅっぱつ！"
 },
 {
  "id": "02eff199",
  "text": "しゅっぱつ しんこう！"
 },
 {
  "id": "598072c1",
  "text": "もっと ながく かいてね"
 },
 {
  "id": "1c5294e5",
  "text": "ゆびで せんろを かいてね！"
 },
 {
  "id": "4eeb0223",
  "text": "とうちゃく！"
 },
 {
  "id": "5d3814ec",
  "text": "せんろを かくよ。 みててね"
 },
 {
  "id": "06845c93",
  "text": "おはなばたけ だよ！"
 },
 {
  "id": "d1c06de8",
  "text": "うみ が みえてきた！"
 },
 {
  "id": "fa95ddb6",
  "text": "やま に きたよ。 トンネル が あるかな？"
 },
 {
  "id": "f53618e9",
  "text": "ゆき が ふってきた！"
 },
 {
  "id": "68c14749",
  "text": "よる に なったよ。 そら を タッチすると はなび！"
 },
 {
  "id": "eee9a9f4",
  "text": "どうぶつさんが まってるよ。 タッチして のせてあげてね"
 },
 {
  "id": "ca18f539",
  "text": "ゆびで ぬってね"
 },
 {
  "id": "bc79ed70",
  "text": "タッチした ところが ぜんぶ ぬれるよ"
 },
 {
  "id": "b0808078",
  "text": "かたちを えらんで、 すきな いろに ぬってね"
 },
 {
  "id": "b9dffc62",
  "text": "すてきな しんかんせん！ しゅっぱつ しよう！"
 },
 {
  "id": "00aa2ad5",
  "text": "にじ だ！ きれいだね"
 },
 {
  "id": "856ed3ce",
  "text": "ばいばーい！"
 },
 {
  "id": "92bff985",
  "text": "タッチして のせてあげてね"
 },
 {
  "id": "6c51fb2e",
  "text": "ドアが しまります"
 },
 {
  "id": "e237d50b",
  "text": "トンネル だ！"
 },
 {
  "id": "24a7b7e1",
  "text": "はし を わたるよ！"
 },
 {
  "id": "590e202c",
  "text": "でたー！"
 },
 {
  "id": "5c4c4c95",
  "text": "どうぶつさんを タッチしてね"
 },
 {
  "id": "bc8c73b6",
  "text": "ゲームで あそぶと シールが もらえるよ！"
 },
 {
  "id": "6c799115",
  "text": "シール ゲット！"
 },
 {
  "id": "3bb3d237",
  "text": "すごい！"
 },
 {
  "id": "520a25db",
  "text": "じょうず！"
 },
 {
  "id": "6d2a75c3",
  "text": "やったね！"
 },
 {
  "id": "db472c4a",
  "text": "ばっちり！"
 },
 {
  "id": "57c5b220",
  "text": "すてき！"
 },
 {
  "id": "80a52881",
  "text": "かんぺき！"
 },
 {
  "id": "f54fc918",
  "text": "いちご えき、 いちご えき です"
 },
 {
  "id": "9a561c08",
  "text": "つぎは いちご えき です"
 },
 {
  "id": "839fafd4",
  "text": "ばなな えき、 ばなな えき です"
 },
 {
  "id": "32fa5409",
  "text": "つぎは ばなな えき です"
 },
 {
  "id": "85a7cca8",
  "text": "もも えき、 もも えき です"
 },
 {
  "id": "849c9579",
  "text": "つぎは もも えき です"
 },
 {
  "id": "d42726d0",
  "text": "めろん えき、 めろん えき です"
 },
 {
  "id": "9df730b6",
  "text": "つぎは めろん えき です"
 },
 {
  "id": "5a1e575c",
  "text": "りんご えき、 りんご えき です"
 },
 {
  "id": "08f703f8",
  "text": "つぎは りんご えき です"
 },
 {
  "id": "f461d298",
  "text": "ぶどう えき、 ぶどう えき です"
 },
 {
  "id": "3cca5184",
  "text": "つぎは ぶどう えき です"
 },
 {
  "id": "e62b0c6c",
  "text": "みかん えき、 みかん えき です"
 },
 {
  "id": "0680fc1e",
  "text": "つぎは みかん えき です"
 },
 {
  "id": "de04d20c",
  "text": "さくらんぼ えき、 さくらんぼ えき です"
 },
 {
  "id": "1cd9c769",
  "text": "つぎは さくらんぼ えき です"
 },
 {
  "id": "20eda300",
  "text": "すいか えき、 すいか えき です"
 },
 {
  "id": "1bd939db",
  "text": "つぎは すいか えき です"
 },
 {
  "id": "f52929de",
  "text": "なし えき、 なし えき です"
 },
 {
  "id": "98dda546",
  "text": "つぎは なし えき です"
 },
 {
  "id": "d1ae4e68",
  "text": "ながい かたち"
 },
 {
  "id": "f0ec319f",
