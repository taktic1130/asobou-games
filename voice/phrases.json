 },
 {
  "id": "ec8cdbfb",
  "text": "あかい とっきゅう が きます"
 },
 {
  "id": "6d0e32f2",
  "text": "きかんしゃ が きます"
 },
 {
  "id": "0e067021",
  "text": "かもつ れっしゃ が きます"
 },
