 },
 {
  "id": "8a826d48",
  "text": "いちご えき！"
 },
 {
  "id": "cb95a5a5",
  "text": "ばなな えき！"
 },
 {
  "id": "065d542a",
  "text": "めろん えき！"
 },
 {
  "id": "27602184",
  "text": "カレー、 ください！"
 },
 {
